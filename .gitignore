# Repo-wide ignores. Per-package ignores live in mobile/.gitignore and
# functions/.gitignore.

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Vite / vitest ephemeral cache (sometimes lands at repo root)
.vite/

# Firebase emulator logs (firebase.json lives at the repo root)
*-debug.log

# Root-level deps: the root package.json runs core's tests/coverage and the
# repo-wide gates. Its node_modules is not committed; the lockfile is, for
# reproducible CI installs.
/node_modules/

# Local demo-seed backups — contain REAL exported user data (Firestore
# todos/profile/groceries for a live account). Never commit to this public repo.
scripts/.seed-backup-*.json

# Claude Code (user-local state)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Personal icon design WIP (kept locally, not committed). EAS requires
# a clean tree so untracked design variants would block builds.
icons/backup/
icons/turtle-icon-5.jpg
coverage/

# Claude Code agent worktrees
.claude/worktrees/
