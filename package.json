{
  "name": "my-todo",
  "version": "1.0.0",
  "private": true,
  "description": "Root = the core/ package's test + coverage runner and the repo-wide gates (dependency-cruiser Clean Architecture check, core typecheck). The iOS app lives in mobile/, the Firebase backend in functions/, shared domain logic in core/. No workspaces/monorepo tooling.",
  "scripts": {
    "lint:arch": "depcruise \"core/src/**/*.{ts,tsx}\" \"mobile/src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\" --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "lint:arch:baseline": "depcruise \"core/src/**/*.{ts,tsx}\" \"mobile/src/**/*.{ts,tsx}\" \"functions/src/**/*.ts\" --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "typecheck:core": "tsc --noEmit -p core && tsc --noEmit -p core/tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^16.10.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
