{
  "name": "sagely-functions",
  "version": "0.1.0",
  "description": "Firebase Cloud Functions for Sagely (Mochi agent proxy, aiInfer, RevenueCat webhook, account erasure, metrics roll-up).",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run --config vitest.rules.config.ts'"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "firebase": "^12.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
